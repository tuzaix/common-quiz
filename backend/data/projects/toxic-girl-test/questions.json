    "dimensionKey": "boundary_blurring",
    "options": [
      {
        "id": "Q10_o1",
        "label": "有，并且觉得这很正常，伴侣不该干涉",
        "value": 3
      },
      {
        "id": "Q10_o2",
        "label": "有，但会注意分寸，也会向伴侣介绍",
        "value": 1
      },
      {
        "id": "Q10_o3",
        "label": "没有这样的异性朋友",
        "value": 0
      },
      {
        "id": "Q10_o4",
        "label": "有，但恋爱后会自然减少联系",
        "value": 0
      }
    ]
  },
  {
    "id": "Q11",
    "type": "single_choice",
    "content": {
