    "dimensionKey": "emotional_manipulation",
    "options": [
      {
        "id": "Q3_o1",
        "label": "更生气，冷战直到对方妥协道歉",
        "value": 3
      },
      {
        "id": "Q3_o2",
        "label": "主动说出自己的感受，尝试沟通解决",
        "value": 0
      },
      {
        "id": "Q3_o3",
        "label": "很难过，但会自己消化情绪",
        "value": 1
      },
      {
        "id": "Q3_o4",
        "label": "觉得对方不在乎自己，考虑分手",
        "value": 2
      }
    ]
  },
  {
    "id": "Q4",
    "type": "single_choice",
    "content": {
      "text": "当伴侣提出想带你见他的家人或朋友时，你的第一反应是？"
    },
    "dimensionKey": "future_ambiguity",
    "options": [
      {
        "id": "Q4_o1",
        "label": "压力很大，找各种理由推脱或延迟",
        "value": 3
      },
      {
        "id": "Q4_o2",
        "label": "开心地接受，认为关系更进一步",
        "value": 0
      },
      {
        "id": "Q4_o3",
        "label": "犹豫，需要时间考虑",
        "value": 2
      },
      {
        "id": "Q4_o4",
        "label": "无所谓，见就见",
        "value": 1
      }
    ]
  },
  {
    "id": "Q5",
    "type": "single_choice",
    "content": {
      "text": "你答应伴侣的事情（比如周末一起去某地），但临时有更吸引你的朋友聚会，你会？"
    },
    "dimensionKey": "responsibility_evasion",
    "options": [
      {
        "id": "Q5_o1",
        "label": "直接找借口（如身体不适）推掉和伴侣的约定",
        "value": 3
      },
      {
        "id": "Q5_o2",
        "label": "坦诚告知，并尝试和伴侣商量改期",
        "value": 1
      },
      {
        "id": "Q5_o3",
        "label": "优先履行对伴侣的承诺",
        "value": 0
      },
      {
        "id": "Q5_o4",
        "label": "看心情，可能爽约也可能不去聚会",
        "value": 2
      }
    ]
  },
  {
    "id": "Q6",
    "type": "single_choice",
    "content": {
      "text": "在社交平台（如朋友圈），你通常会如何展示自己的感情状态？"
    },
    "dimensionKey": "boundary_blurring",
    "options": [
      {
        "id": "Q6_o1",
        "label": "几乎不发与伴侣相关的内容，保持“单身”人设",
        "value": 3
      },
      {
        "id": "Q6_o2",
        "label": "偶尔发合照或暗示，但不明确说明关系",
        "value": 2
      },
      {
        "id": "Q6_o3",
        "label": "大方分享，会标注男友/女友",
        "value": 0
      },
      {
        "id": "Q6_o4",
        "label": "很少发私人生活，专注分享其他内容",
        "value": 1
      }
    ]
  },
  {
    "id": "Q7",
    "type": "single_choice",
    "content": {
      "text": "当伴侣遇到重大困难（如失业、家人生病）情绪低落时，你的做法更接近？"
    },
    "dimensionKey": "lack_of_reciprocity",
    "options": [
      {
        "id": "Q7_o1",
        "label": "觉得他负能量太多，暂时减少联系，等他自己好起来",
        "value": 3
      },
      {
        "id": "Q7_o2",
        "label": "给予安慰和鼓励，并尽力提供实际帮助",
        "value": 0
      },
      {
        "id": "Q7_o3",
        "label": "口头安慰一下，但不会花费太多精力",
        "value": 2
      },
      {
        "id": "Q7_o4",
        "label": "感到烦躁，可能因此指责他不够坚强",
        "value": 3
      }
    ]
  },
  {
    "id": "Q8",
    "type": "single_choice",
    "content": {
      "text": "你如何看待恋爱中的消费？"
    },
    "dimensionKey": "material_demand",
    "options": [
      {
        "id": "Q8_o1",
        "label": "男生付钱是天经地义的",
        "value": 3
      },
      {
        "id": "Q8_o2",
        "label": "轮流付钱或AA制比较公平",
        "value": 0
      },
      {
        "id": "Q8_o3",
        "label": "大部分时候对方付，我偶尔付一点",
        "value": 2
      },
      {
        "id": "Q8_o4",
        "label": "谁提出约会谁付钱，或者看经济情况",
        "value": 1
      }
    ]
  },
  {
    "id": "Q9",
    "type": "single_choice",
    "content": {
      "text": "如果你对伴侣有所不满，你更倾向于如何表达？"
