    "dimensionKey": "physiological",
    "options": [
      {
        "id": "Q1_o1",
        "label": "全程一起狂欢，从日出到夜晚都一起嗨！",
        "value": 3
      },
      {
        "id": "Q1_o2",
        "label": "各自享受当下，偶尔一起交流精彩的瞬间",
        "value": 2
      },
      {
        "id": "Q1_o3",
        "label": "全程安静的一起肩并肩听音乐",
        "value": 1
      }
